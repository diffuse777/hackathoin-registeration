# Server
NODE_ENV=development
PORT=5000

# MongoDB Atlas
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hackathon_registration?retryWrites=true&w=majority
# On Vercel, allow Atlas Network Access from 0.0.0.0/0
MONGODB_URI=

# Auth
# Use a long, random secret in production (at least 32 characters).
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Frontend origin allowed by CORS
# Local: http://localhost:5173
# Vercel: https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# Payment gateway (never commit real keys)
# PAYMENT_PROVIDER=mock | razorpay
# Production / Vercel must use razorpay (mock is blocked).
PAYMENT_PROVIDER=
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Initial admin credentials (never commit real values)
# Production ADMIN_PASSWORD must be at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
